---
import { MAIN_NAV_ITEMS, isActivePath } from '../data/navigation';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="site-header">
  <div class="container">
    <a href="/" class="brand-link" aria-label="NexaTV — Retour à l'accueil">
      <img src="/logo-nexatv.jpg" alt="NexaTV Logo" style="height: 45px; width: auto; mix-blend-mode: lighten;" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Navigation principale">
      <ul>
        {
          MAIN_NAV_ITEMS.map((item) => {
            const active = isActivePath(currentPath, item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', { active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Mobile Navigation (Native HTML Details/Summary disclosure) -->
    <div class="mobile-nav">
      <details class="mobile-nav-details">
        <summary class="mobile-nav-summary" aria-label="Menu principal">
          <svg
            class="mobile-nav-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"
            />
          </svg>
          <span>Menu</span>
        </summary>
        <nav class="mobile-nav-dropdown" aria-label="Navigation mobile">
          <ul>
            {
              MAIN_NAV_ITEMS.map((item) => {
                const active = isActivePath(currentPath, item.href);
                return (
                  <li>
                    <a
                      href={item.href}
                      class:list={['nav-link', { active }]}
                      aria-current={active ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
